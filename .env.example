# Copy to .env beside docker-compose.yml. Compose reads it automatically;
# shell environment variables take precedence. Apply changes with
# `docker compose up -d` (a plain restart does not reload .env).

# Image to run with docker-compose.yml. Pin a reviewed tag or digest for
# reproducible deployments. docker-compose.dev.yml ignores it.
# MANGAYOMI_IMAGE=yexca/mangayomi:latest

# Host port for the web UI and API.
# MANGAYOMI_PORT=7652

# User and group that own the manga files on the host (run `id` on the NAS).
# The container runs as this user so deletions and new files keep the right owner.
# PUID=1000
# PGID=1000

# Time zone used in logs.
# TZ=UTC

# Set to any value to enable debug logging.
# MANGAYOMI_DEBUG=
